{
  "description": "Capture Codex conversation turns in SurrealDB Agent Memory.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/agent-memory-hook.js\" prompt",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\agent-memory-hook.js\" prompt",
            "timeout": 10,
            "statusMessage": "Staging turn for Agent Memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/agent-memory-hook.js\" stop",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\agent-memory-hook.js\" stop",
            "timeout": 45,
            "statusMessage": "Saving conversation to Agent Memory"
          }
        ]
      }
    ]
  }
}
